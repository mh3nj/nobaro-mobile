# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# Windows
*.lnk
Thumbs.db

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Android/Gradle build output and local machine config — never ship these
android/.gradle/
android/build/
android/local.properties
android/app/build/

# Signing secrets — never commit these
*.jks
*.keystore
key.properties
android/app/key.properties
android/app/upload-keystore.jks

# Local tooling / agent scratch space
.freebuff/

# Release bundles (built locally, uploaded to GitHub Releases separately)
/release/
